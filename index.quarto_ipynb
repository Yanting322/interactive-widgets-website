      "source": [
        "---\n",
        "title: \"Crime Dashboard\"\n",
        "format: html\n",
        "---\n",
        "\n",
        "\n",
        "## 📊 Monthly Crime Count, Temperature & Precipitation\n"
      ],
      "id": "f4b1d5e4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import plotly.graph_objects as go\n",
        "\n",
        "# 聚合数据\n",
        "monthly = df_interactive.groupby('month').agg({\n",
        "    'crime_code_description': 'count',\n",
        "    'daily_avg_temperature_celsius': 'mean',\n",
        "    'daily_precipitation_mm': 'mean'\n",
        "}).reset_index()\n",
        "\n",
        "# 绘图\n",
        "fig = go.Figure()\n",
        "fig.add_trace(go.Bar(x=monthly['month'], y=monthly['crime_code_description'], name='Crime Count'))\n",
        "fig.add_trace(go.Scatter(x=monthly['month'], y=monthly['daily_avg_temperature_celsius'], name='Avg Temp (°C)', mode='lines+markers'))\n",
        "fig.add_trace(go.Scatter(x=monthly['month'], y=monthly['daily_precipitation_mm'], name='Avg Precipitation (mm)', mode='lines+markers'))\n",
        "\n",
        "fig.update_layout(\n",
        "    title='Monthly Crime Count, Avg Temperature, and Precipitation',\n",
        "    xaxis_title='Month',\n",
        "    yaxis_title='Crime Count',\n",
        "    template='plotly_white'\n",
        ")\n",
        "\n",
        "# 关键行 ✅ 保存为独立 HTML 图表\n",
        "fig.write_html(\"docs/crime_temp_precip_chart.html\")"
      ],
      "id": "c999d4c4",
      "execution_count": null,
      "outputs": []
    },
    {
